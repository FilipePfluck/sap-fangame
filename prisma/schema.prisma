// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model User {
  id        String   @id @default(cuid())
  email     String   @unique
  password  String
  name      String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  games Game[]
  packs Pack[]
}

// A custom pack saved by a user (Pack spec). Pets and foods are stored by ID;
// isValid and WILD aren't stored, they're worked out again on every read.
model Pack {
  id        Int      @id @default(autoincrement())
  petsId    Int[]
  foodsId   Int[]
  name      String
  iconId    Int
  ownerId   String
  owner     User     @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([ownerId])
}

enum GameStatus {
  ACTIVE
  WON
  LOST
}

// Whether a pack is one of the game's static packs or a player's custom pack.
enum PackKind {
  STATIC
  CUSTOM
}

// The pack menu's matchmaking toggle (see opponentPackKinds in lib/game/matchmaking.ts).
enum MatchmakingMode {
  SAME_PACK
  ALL_PACKS
}

enum BattleResult {
  WIN
  DRAW
  LOSS
}

model Game {
  id          String     @id @default(cuid())
  playerId    String
  player      User       @relation(fields: [playerId], references: [id])
  status      GameStatus @default(ACTIVE)
  // The pack this game rolls, as a SerializedPack. Null for games from before packs, which roll Turtle.
  pack        Json?
  matchmakingMode MatchmakingMode @default(SAME_PACK)
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt

  turns       GameTurn[]
  boardStates BoardState[]
  battles     Battle[]

  @@index([playerId])
}

model GameTurn {
  id         String   @id @default(cuid())
  gameId     String
  game       Game     @relation(fields: [gameId], references: [id])
  turnNumber Int
  lives      Int      @default(5)
  trophies   Int      @default(0)
  createdAt  DateTime @default(now())

  boardStates BoardState[]

  @@index([gameId])
}

model BoardState {
  id            String   @id @default(cuid())
  gameId        String
  game          Game     @relation(fields: [gameId], references: [id])
  turnId        String
  turn          GameTurn @relation(fields: [turnId], references: [id])
  boardState    Json
  shopState     Json
  goldRemaining Int
  createdAt     DateTime @default(now())

  @@index([gameId, createdAt(sort: Desc)])
}

model Battle {
  id           String       @id @default(cuid())
  gameId       String
  game         Game         @relation(fields: [gameId], references: [id])
  opponentTeam Json
  opponentName String?
  result       BattleResult
  steps        Json
  createdAt    DateTime     @default(now())

  @@index([gameId])
}

model SubmittedTeam {
  id         String   @id @default(cuid())
  gameId     String
  playerId   String
  playerName String
  turnNumber Int
  lives      Int
  trophies   Int
  team       Json
  packKind   PackKind @default(STATIC)
  createdAt  DateTime @default(now())

  @@index([turnNumber, packKind, lives, trophies])
  @@index([playerId])
}
